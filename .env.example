# Copy to .env.local (ignored) or export in your shell.
# Never commit real credentials.

CARDIO_GRAPH_NEO4J_URI=bolt://neo4j-dev4.internal:7687
CARDIO_GRAPH_NEO4J_USER=neo4j
CARDIO_GRAPH_NEO4J_PASSWORD=change-me

# Optional: used by feedneo4jdb.py for Cypher input dir
CARDIO_GRAPH_CYPHER_DIR=/prj/doctoral_letters/guide/outputs2/cypher

# Optional: override secrets file path (default: ~/.config/cardio_graph/secrets.env)
# CARDIO_GRAPH_SECRETS_ENV_PATH=/custom/path/secrets.env
